# Rizoma monorepo — SYNTHETIC demo values for local development.
# Copy to .env. Never reuse these values in any shared or production
# environment; real secrets live in the secret vault.
#
#   cp .env.example .env

# --- Runtime ---
NODE_ENV=development

# --- Postgres 16 (direct connection; migrations and admin tasks) ---
POSTGRES_USER=rizoma
POSTGRES_PASSWORD=rizoma_demo_password
POSTGRES_DB=rizoma
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rizoma:rizoma_demo_password@localhost:5432/rizoma

# --- PgBouncer (transaction pooling; request-time app connection) ---
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
DATABASE_URL_PGBOUNCER=postgresql://rizoma:rizoma_demo_password@localhost:6432/rizoma

# --- Redis 7 (BullMQ) ---
REDIS_PASSWORD=rizoma_demo_password
REDIS_PORT=6379
REDIS_URL=redis://:rizoma_demo_password@localhost:6379

# --- Keycloak 25+ (OIDC + MFA) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=rizoma_demo_password
KEYCLOAK_DB=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_MANAGEMENT_PORT=9000
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=rizoma

# --- S3 local (LocalStack, S3-compatible) ---
S3_ACCESS_KEY_ID=rizoma
S3_SECRET_ACCESS_KEY=rizoma_demo_password
S3_REGION=us-east-1
S3_PORT=4566
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=rizoma-local
