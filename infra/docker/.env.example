# Rizoma local infrastructure — SYNTHETIC demo values.
# Copy to infra/docker/.env for local use. Never reuse these values anywhere
# shared or production; real secrets live in the secret vault.
#
#   cp infra/docker/.env.example infra/docker/.env
#   docker compose -f infra/docker/compose.yml --env-file infra/docker/.env up -d

# --- Postgres 16 ---
POSTGRES_USER=rizoma
POSTGRES_PASSWORD=rizoma_demo_password
POSTGRES_DB=rizoma
POSTGRES_PORT=5432

# --- PgBouncer (transaction pooling) ---
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20

# --- Redis 7 (BullMQ) ---
REDIS_PASSWORD=rizoma_demo_password
REDIS_PORT=6379

# --- Keycloak 25+ (OIDC + MFA) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=rizoma_demo_password
KEYCLOAK_DB=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_MANAGEMENT_PORT=9000

# --- S3 local (LocalStack, S3-compatible) ---
S3_ACCESS_KEY_ID=rizoma
S3_SECRET_ACCESS_KEY=rizoma_demo_password
S3_REGION=us-east-1
S3_PORT=4566
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=rizoma-local
